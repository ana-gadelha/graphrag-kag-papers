NEO4J_URI=neo4j+s://SEU_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=SUA_SENHA
NEO4J_DATABASE=neo4j

# Modelo gratuito OpenAI-compatible; confirme disponibilidade/quota na sua conta.
RETRIEVAL_LLM_BASE_URL=https://openrouter.ai/api/v1
RETRIEVAL_LLM_API_KEY=SUA_CHAVE_OPENROUTER
RETRIEVAL_LLM_MODEL=MODELO_GRATUITO_DISPONIVEL
RETRIEVAL_LLM_API=chat_completions
RETRIEVAL_LLM_TIMEOUT=120
# Inclui raciocínio em modelos que contabilizam pensamento no limite de geração.
RETRIEVAL_LLM_MAX_OUTPUT_TOKENS=8192
RETRIEVAL_LLM_MAX_RETRIES=0

# Extração e planejamento herdam o RETRIEVAL_LLM_MODEL explícito acima.
# Para configurar cada etapa independentemente, descomente os overrides.
# Se definir outra BASE_URL, configure sua própria API_KEY (a chave não é herdada).
# EXTRACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
# EXTRACTION_LLM_API_KEY=SUA_CHAVE
# EXTRACTION_LLM_MODEL=MODELO_GRATUITO_DISPONIVEL
# EXTRACTION_LLM_API=chat_completions
# EXTRACTION_LLM_TIMEOUT=120
# EXTRACTION_LLM_MAX_OUTPUT_TOKENS=8192
# EXTRACTION_LLM_MAX_RETRIES=0
# CYPHER_LLM_MODEL=MODELO_GRATUITO_DISPONIVEL
# CYPHER_LLM_MAX_OUTPUT_TOKENS=8192
# CYPHER_LLM_MAX_RETRIES=0

# Orçamento operacional local compartilhado pelas etapas. Não representa a quota
# oficial; tentativas que falham também consomem este orçamento. Dia = UTC.
LLM_CACHE_DIR=output/llm_cache
LLM_DAILY_REQUEST_BUDGET=40
LLM_REQUESTS_PER_MINUTE=10
# Desativar cache/ledger (somente testes isolados): LLM_CACHE_ENABLED=0

# Compatibilidade legada de resposta via OpenAI, sem fallback automático entre APIs.
# OPENAI_API_KEY=SUA_CHAVE_OPENAI
# OPENAI_MODEL=IDENTIFICADOR_EXPLICITO
